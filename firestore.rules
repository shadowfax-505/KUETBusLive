rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Who is asking ----------

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile() && me().role == 'admin';
    }

    function isApproved() {
      return hasProfile() && me().get('isApproved', false) == true;
    }

    // Approved, and not deactivated by the admin (a driver who left the job).
    function isApprovedDriver() {
      return isApproved() && me().role == 'driver' && me().get('active', true) == true;
    }

    // ---------- Bus assignment ----------
    // Who drives a fleet bus right now: the cover driver while the cover's dates
    // include today (start and end are stored as timestamps for this check),
    // otherwise the regular driver.
    function coverActive(bus) {
      return bus.get('cover', null) != null
        && request.time >= bus.cover.start && request.time < bus.cover.end;
    }

    function drivesToday(fleetBusId) {
      let path = /databases/$(database)/documents/fleet/$(fleetBusId);
      let bus = get(path).data;
      return exists(path)
        && ((coverActive(bus) && bus.cover.driverId == request.auth.uid)
            || (!coverActive(bus) && bus.get('defaultDriverId', null) == request.auth.uid));
    }

    // Who drives one trip (a schedule document) of a fleet bus: the driver set for that
    // trip in tripDrivers if there is one, otherwise whoever drives the bus today.
    function drivesTrip(fleetBusId, scheduleId) {
      let path = /databases/$(database)/documents/fleet/$(fleetBusId);
      let tripDriver = get(path).data.get('tripDrivers', {}).get(scheduleId, null);
      return exists(path)
        && ((tripDriver != null && tripDriver == request.auth.uid)
            || (tripDriver == null && drivesToday(fleetBusId)));
    }

    // Students and teachers ride buses. Teachers must be approved first; students start approved.
    function isApprovedRider() {
      return isApproved() && me().role in ['student', 'teacher'];
    }

    // Students may only touch student buses. Teachers may ride any bus.
    function canBoard(bus) {
      return me().role != 'student' || bus.get('audience', 'student') == 'student';
    }

    // ---------- Small checks ----------

    function isShortText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isCrowdLevel(value) {
      return value in ['unknown', 'seats', 'full'];
    }

    // ---------- Users ----------

    match /users/{uid} {
      // Your own profile, or anyone's if you are the admin (to approve teachers and drivers).
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Sign up: only your own profile, with your own login email, never as admin,
      // and only students start approved. Teachers and drivers wait for the admin.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'kuetId', 'isApproved',
            'favoriteStopName', 'favoriteStopLat', 'favoriteStopLng', 'fcmToken'])
        && isShortText(request.resource.data.name, 100)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'teacher', 'driver']
        && isShortText(request.resource.data.kuetId, 30)
        && request.resource.data.isApproved == (request.resource.data.role == 'student');

      // The admin can change anything, including role and approval.
      // You can only change your favourite stop, your push token and your name.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['name', 'favoriteStopName', 'favoriteStopLat', 'favoriteStopLng', 'fcmToken'])
            && isShortText(request.resource.data.name, 100));

      // Profile > Delete account removes your own profile. The admin can remove anyone's.
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // ---------- My places: a rider's own boarding points ----------

    match /users/{uid}/places/{placeId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;

      // Only your own, at most five (IDs p1 ... p5), with a short label and a position.
      allow create, update: if signedIn() && request.auth.uid == uid
        && placeId in ['p1', 'p2', 'p3', 'p4', 'p5']
        && request.resource.data.keys().hasOnly(['label', 'kind', 'lat', 'lng', 'createdAt'])
        && isShortText(request.resource.data.label, 40)
        && request.resource.data.kind in ['home', 'tuition', 'other']
        && request.resource.data.lat is number && request.resource.data.lng is number;
    }

    // ---------- Ride history (smart suggestions), only if the rider turns on the backup ----------

    match /users/{uid}/rideHistory/{eventId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'kind', 'tripTitle', 'routeId', 'boardingKey',
            'boardingName', 'dayType', 'minuteOfDay', 'date'])
        && request.resource.data.kind in ['followed', 'alerted', 'waved', 'boarded']
        && request.resource.data.dayType in ['sunToThu', 'saturday', 'friday']
        && request.resource.data.minuteOfDay is int
        && isShortText(request.resource.data.tripTitle, 80);
    }

    // ---------- Timetable, routes and news: everyone reads, only the admin writes ----------

    match /schedules/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /routes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && isShortText(request.resource.data.title, 200)
        && isShortText(request.resource.data.body, 5000);
      allow update, delete: if isAdmin();
    }

    // ---------- Running buses ----------

    match /buses/{id} {
      function busFields() {
        return ['number', 'routeId', 'routeName', 'driverId', 'lat', 'lng', 'updatedAt',
                'crowd', 'audience', 'scheduleId', 'heading', 'speed', 'fleetBusId'];
      }

      function isValidBus(bus) {
        return bus.keys().hasOnly(busFields())
          && bus.driverId == request.auth.uid
          && bus.lat is number && bus.lng is number
          && isCrowdLevel(bus.crowd);
      }

      allow read: if signedIn();

      // An approved driver starts a trip, as themselves, only on a fleet bus trip
      // they drive. The document ID is "bus-" + the fleet bus, so two drivers can
      // never run the same bus at once.
      allow create: if isApprovedDriver() && isValidBus(request.resource.data)
        && id == 'bus-' + request.resource.data.fleetBusId
        && drivesTrip(request.resource.data.fleetBusId, request.resource.data.get('scheduleId', ''));

      // The admin can fix anything. An approved driver moves only their own bus:
      // position, heading, speed and time. Anything else (route, trip, audience) may
      // change only by starting a trip again, with the same checks as a new trip.
      // Riders allowed on the bus can change only its crowd level.
      allow update: if isAdmin()
        || (isApprovedDriver() && resource.data.driverId == request.auth.uid
            && isValidBus(request.resource.data)
            && (request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['lat', 'lng', 'updatedAt', 'heading', 'speed'])
                || (id == 'bus-' + request.resource.data.fleetBusId
                    && drivesTrip(request.resource.data.fleetBusId, request.resource.data.get('scheduleId', '')))))
        || (isApprovedRider() && canBoard(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['crowd'])
            && isCrowdLevel(request.resource.data.crowd));

      // Ending a trip (or deleting the account) removes the driver's own bus.
      allow delete: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
    }

    // ---------- "I'm waiting here" waves ----------

    match /buses/{busId}/waves/{waveId} {
      function bus() {
        return get(/databases/$(database)/documents/buses/$(busId)).data;
      }

      function busExists() {
        return exists(/databases/$(database)/documents/buses/$(busId));
      }

      // The rider who waved, the bus's driver, or the admin. Other riders can't see who waits where.
      allow read: if signedIn()
        && (waveId == request.auth.uid || isAdmin() || (busExists() && bus().driverId == request.auth.uid));

      // An approved rider waves at a running bus they may ride. The document ID is
      // their uid (one wave per bus), and it must run out within 20 minutes.
      allow create, update: if isApprovedRider() && waveId == request.auth.uid
        && busExists() && canBoard(bus())
        && request.resource.data.keys().hasOnly(['uid', 'label', 'lat', 'lng', 'createdAt', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && isShortText(request.resource.data.label, 60)
        && request.resource.data.lat is number && request.resource.data.lng is number
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(20, 'm');

      // The rider cancels, or the driver clears it once the bus has passed.
      allow delete: if signedIn()
        && (waveId == request.auth.uid || isAdmin() || (busExists() && bus().driverId == request.auth.uid));
    }

    // ---------- "Please stop here": where a rider wants to get off ----------

    match /buses/{busId}/dropoffs/{uid} {
      function bus() {
        return get(/databases/$(database)/documents/buses/$(busId)).data;
      }

      function busExists() {
        return exists(/databases/$(database)/documents/buses/$(busId));
      }

      // Same people as waves: the rider, the bus's driver, or the admin.
      allow read: if signedIn()
        && (uid == request.auth.uid || isAdmin() || (busExists() && bus().driverId == request.auth.uid));

      // One request per rider per bus, for a bus they may ride, lasting at most two hours.
      allow create, update: if isApprovedRider() && uid == request.auth.uid
        && busExists() && canBoard(bus())
        && request.resource.data.keys().hasOnly(['uid', 'label', 'lat', 'lng', 'createdAt', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && isShortText(request.resource.data.label, 60)
        && request.resource.data.lat is number && request.resource.data.lng is number
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(120, 'm');

      allow delete: if signedIn()
        && (uid == request.auth.uid || isAdmin() || (busExists() && bus().driverId == request.auth.uid));
    }

    // ---------- Learned travel model (best place to wait / to get off) ----------
    // Only numbers, never a GPS track or who rode where. Everyone signed in reads them.
    // The driver of a running bus adds one trip at a time, for that bus's route only,
    // before the trip ends. Each write adds exactly one sample (n goes up by one).

    // The bus `busId` is running now, driven by the person asking, on `routeId`.
    function drivesRouteNow(busId, routeId) {
      let path = /databases/$(database)/documents/buses/$(busId);
      return busId is string && exists(path)
        && get(path).data.driverId == request.auth.uid
        && get(path).data.routeId == routeId;
    }

    function isRunningStat(data) {
      return data.n is int && data.mean is number && data.variance is number
        && data.mean >= 0 && data.mean <= 7200
        && data.variance >= 0 && data.variance <= 51840000;
    }

    match /segmentStats/{id} {
      function fields() {
        return ['routeId', 'kind', 'index', 'dayType', 'slot', 'driverId', 'n', 'mean', 'variance',
                'lastBusId', 'updatedAt'];
      }

      // A per-driver document carries the driver's uid, at the end of its ID too.
      function ownDriverField(data) {
        return !('driverId' in data)
          || (data.driverId == request.auth.uid && id.matches('.*_' + request.auth.uid));
      }

      function validStat(data) {
        return data.keys().hasOnly(fields())
          && data.kind in ['travel', 'dwell']
          && data.index is int && data.index >= 0 && data.index < 100
          && id.split('_')[0] == data.routeId
          && ownDriverField(data)
          && isRunningStat(data)
          && drivesRouteNow(data.lastBusId, data.routeId);
      }

      allow read: if signedIn();
      allow create: if isApprovedDriver() && validStat(request.resource.data)
        && request.resource.data.n == 1;
      allow update: if isApprovedDriver() && validStat(request.resource.data)
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.routeId == resource.data.routeId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.index == resource.data.index
        && request.resource.data.get('driverId', '') == resource.data.get('driverId', '');
      allow delete: if isAdmin();
    }

    // Spots on a route (about 30 m squares) where drivers were asked to stop and did,
    // and where riders got off. No uid is stored: a drop-off is just a count.
    match /spotStats/{id} {
      function fields() {
        return ['routeId', 'lat', 'lng', 'asks', 'stops', 'dropoffs', 'lastBusId', 'updatedAt'];
      }

      function validSpot(data) {
        return data.keys().hasOnly(fields())
          && id.split('_')[0] == data.routeId
          && data.lat is number && data.lng is number
          && data.asks is int && data.stops is int && data.dropoffs is int
          && data.stops >= 0 && data.stops <= data.asks;
      }

      allow read: if signedIn();

      // The driver records one wave on a running bus: asked once more, stopped or not.
      // A rider records one drop-off, and nothing else.
      allow create: if validSpot(request.resource.data)
        && ((isApprovedDriver() && drivesRouteNow(request.resource.data.lastBusId, request.resource.data.routeId)
             && request.resource.data.asks == 1 && request.resource.data.dropoffs == 0)
          || (isApprovedRider() && !('lastBusId' in request.resource.data)
             && request.resource.data.asks == 0 && request.resource.data.stops == 0
             && request.resource.data.dropoffs == 1));

      allow update: if validSpot(request.resource.data)
        && request.resource.data.routeId == resource.data.routeId
        && request.resource.data.lat == resource.data.lat && request.resource.data.lng == resource.data.lng
        && ((isApprovedDriver() && drivesRouteNow(request.resource.data.lastBusId, request.resource.data.routeId)
             && request.resource.data.asks == resource.data.asks + 1
             && request.resource.data.stops >= resource.data.stops
             && request.resource.data.stops <= resource.data.stops + 1
             && request.resource.data.dropoffs == resource.data.dropoffs)
          || (isApprovedRider()
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dropoffs', 'updatedAt'])
             && request.resource.data.dropoffs == resource.data.dropoffs + 1));

      allow delete: if isAdmin();
    }

    // How often each driver stops when a rider waves. Only that driver adds to it.
    match /driverStats/{uid} {
      allow read: if signedIn();
      allow create: if isApprovedDriver() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['asks', 'stops', 'updatedAt'])
        && request.resource.data.asks == 1
        && request.resource.data.stops is int && request.resource.data.stops >= 0
        && request.resource.data.stops <= 1;
      allow update: if isApprovedDriver() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['asks', 'stops', 'updatedAt'])
        && request.resource.data.asks == resource.data.asks + 1
        && request.resource.data.stops >= resource.data.stops
        && request.resource.data.stops <= resource.data.stops + 1;
      allow delete: if isAdmin();
    }

    // ---------- Fleet: regular, cover and trip drivers (only the admin assigns) ----------

    match /fleet/{busId} {
      allow read: if signedIn();
      // tripDrivers, when present, is a map of schedule ID -> driver uid.
      allow create, update: if isAdmin()
        && request.resource.data.get('tripDrivers', {}) is map;
      allow delete: if isAdmin();
    }

    // ---------- "I can't drive" requests ----------

    match /driverAbsences/{id} {
      allow read: if signedIn() && (resource.data.driverId == request.auth.uid || isAdmin());

      allow create: if isApprovedDriver()
        && request.resource.data.keys().hasOnly(['driverId', 'driverName', 'fromDate', 'untilDate',
            'reason', 'status', 'createdAt'])
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.fromDate is string && request.resource.data.untilDate is string
        && request.resource.data.fromDate <= request.resource.data.untilDate
        && isShortText(request.resource.data.reason, 300);

      // The admin answers it. A driver may withdraw their own request.
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
    }

    // ---------- Trip history: who drove which bus, and when ----------

    match /trips/{id} {
      allow read: if signedIn() && (resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isApprovedDriver()
        && request.resource.data.keys().hasOnly(['driverId', 'fleetBusId', 'scheduleId', 'routeId',
            'startedAt', 'endedAt'])
        && request.resource.data.driverId == request.auth.uid
        && drivesTrip(request.resource.data.fleetBusId, request.resource.data.scheduleId);
      // Only the end time can be added later, by the same driver.
      allow update: if signedIn() && resource.data.driverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt']);
    }

    // ---------- Complaints ----------

    match /complaints/{id} {
      function categories() {
        return ['late', 'driverBehaviour', 'overcrowding', 'busCondition', 'app', 'other'];
      }

      // The sender, or the admin.
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // Anyone signed in with a profile files a complaint as themselves.
      // It starts open, unread and without a reply.
      allow create: if hasProfile()
        && request.resource.data.keys().hasOnly(['uid', 'userName', 'userRole', 'category',
            'routeName', 'busName', 'tripTime', 'text', 'createdAt', 'status', 'readByAdmin'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userRole == me().role
        && request.resource.data.category in categories()
        && isShortText(request.resource.data.text, 2000)
        && request.resource.data.status == 'open'
        && request.resource.data.readByAdmin == false;

      // Nobody edits a complaint after sending it. The admin changes only the
      // status, the reply and whether it was read.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'adminReply', 'repliedAt', 'readByAdmin'])
        && request.resource.data.status in ['open', 'inReview', 'resolved'];

      // Deleting your account removes your complaints too.
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Everything else ----------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
