{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ %@, %lld percent of the trip done": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@, যাত্রার %3$lld শতাংশ শেষ"
          }
        }
      }
    },
    "%@ at %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এ %1$@"
          }
        }
      }
    },
    "%@ at %@ from %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এ %3$@ থেকে %1$@"
