    "Sign Out": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন আউট"
          }
        }
      }
    },
    "Sign Up": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন আপ"
          }
        }
      }
    },
    "Special trips are teacher buses, so they are hidden. Students can only ride Normal trips.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Special ট্রিপগুলো শিক্ষকদের বাস, তাই লুকানো আছে। শিক্ষার্থীরা শুধু Normal ট্রিপে উঠতে পারে।"
          }
        }
      }
    },
    "Staff ID": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্টাফ আইডি"
          }
        }
      }
    },
    "Start trip": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রিপ শুরু করুন"
          }
        }
      }
    },
    "Starting spot, e.g. Rupsha": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর জায়গা, যেমন Rupsha"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থা"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্টপ"
          }
        }
      }
    },
    "Stop %lld, %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld নম্বর স্টপ, %2$@"
          }
        }
      }
    },
    "Stop following": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলো করা বন্ধ করুন"
          }
        }
      }
    },
    "Stop name": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্টপের নাম"
          }
        }
      }
    },
    "Stop: %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্টপ: %@"
          }
        }
      }
    },
    "Stops (%lld)": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্টপ (%lld)"
          }
        }
      }
    },
    "Student": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিক্ষার্থী"
          }
        }
      }
    },
    "Student bus": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিক্ষার্থীদের বাস"
          }
        }
      }
    },
    "Student buses only": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু শিক্ষার্থীদের বাস"
          }
        }
      }
    },
    "Students can't ride a %@.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিক্ষার্থীরা %@-এ উঠতে পারে না।"
          }
        }
      }
    },
    "Sunday to Thursday": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রবিবার থেকে বৃহস্পতিবার"
          }
        }
      }
    },
    "Tap Edit to drag stops into the right order. Swipe a stop to delete it. A route needs at least two stops.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্টপগুলো টেনে সঠিক ক্রমে সাজাতে এডিট চাপুন। কোনো স্টপ মুছতে সোয়াইপ করুন। একটা রুটে কমপক্ষে দুটো স্টপ লাগে।"
          }
        }
      }
    },
    "Tap the map to add a stop at that spot. The line joins the stops in order.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যাপের যেখানে ট্যাপ করবেন সেখানে স্টপ যোগ হবে। লাইনটা ক্রম অনুযায়ী স্টপগুলো জোড়ে।"
          }
        }
      }
    },
    "Teacher": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিক্ষক"
          }
        }
      }
    },
    "Teacher bus": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিক্ষকদের বাস"
          }
        }
      }
    },
    "Teachers can ride any bus, Normal or Special.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিক্ষকরা Normal বা Special যেকোনো বাসে উঠতে পারেন।"
          }
        }
      }
    },
    "Tell the transport office what happened": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবহন দপ্তরকে জানান কী হয়েছিল"
          }
        }
      }
    },
    "Thank you. You can follow it in My complaints.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধন্যবাদ। আমার অভিযোগ থেকে এর অবস্থা দেখতে পারবেন।"
          }
        }
      }
    },
    "That password is not right. Nothing was deleted.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসওয়ার্ডটি সঠিক নয়। কিছুই মোছা হয়নি।"
          }
        }
      }
    },
    "The KUET transport office will check your %@ (%@). This screen opens the app as soon as you're approved.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "KUET পরিবহন দপ্তর আপনার %1$@ (%2$@) যাচাই করবে। অনুমোদন পেলেই এই স্ক্রিন থেকে অ্যাপ খুলে যাবে।"
          }
        }
      }
    },
    "The app follows your phone's language. To use it in Bangla, set Bangla in Settings > General > Language & Region, or choose it for this app only in Settings > KUET Bus Live > Language.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটা আপনার ফোনের ভাষা অনুসরণ করে। বাংলায় ব্যবহার করতে Settings > General > Language & Region-এ বাংলা বেছে নিন, অথবা শুধু এই অ্যাপের জন্য Settings > KUET Bus Live > Language থেকে বেছে নিন।"
          }
        }
      }
    },
    "The app locks when you leave it. With both on, Face ID is tried first and the passcode is the backup.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ থেকে বের হলেই এটা লক হয়ে যায়। দুটোই চালু থাকলে আগে Face ID, তারপর পাসকোড।"
          }
        }
      }
    },
    "The next bus you can take, how long until it leaves, and how far along it is.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরের বাস, ছাড়তে কত বাকি, আর কতদূর এসেছে।"
          }
        }
      }
    },
    "The passcodes didn't match. Try again.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাসকোড মেলেনি। আবার চেষ্টা করুন।"
          }
        }
      }
    },
    "The person who sent it sees this reply in My complaints.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যিনি পাঠিয়েছেন তিনি আমার অভিযোগ-এ এই উত্তর দেখবেন।"
          }
        }
      }
    },
    "The roll number doesn't match the one in your KUET email.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রোল নম্বরটা আপনার KUET ইমেইলের রোলের সাথে মিলছে না।"
          }
        }
      }
    },
    "The transport admin hasn't added trips or routes yet.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবহন অ্যাডমিন এখনো ট্রিপ বা রুট যোগ করেননি।"
          }
        }
      }
    },
    "The transport office checks your driver ID before you can start trips.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রিপ শুরু করার আগে পরিবহন দপ্তর আপনার ড্রাইভার আইডি যাচাই করবে।"
          }
        }
      }
    },
    "This bus has ended its trip.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বাসের ট্রিপ শেষ হয়েছে।"
          }
        }
      }
    },
    "This permanently deletes your profile (name, email, KUET ID and favourite stop), your places, your complaints, your push token and your login, and clears the app's settings on this phone. It cannot be undone.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার প্রোফাইল (নাম, ইমেইল, KUET আইডি ও প্রিয় স্টপ), আপনার জায়গাগুলো, অভিযোগ, পুশ টোকেন ও লগইন চিরতরে মুছে দেয় এবং এই ফোনে অ্যাপের সেটিংস মুছে ফেলে। এটি আর ফেরানো যাবে না।"
          }
        }
      }
    },
    "Times (24-hour, e.g. 17:10)": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় (২৪ ঘণ্টা, যেমন 17:10)"
          }
        }
      }
    },
    "Title, e.g. Normal-2 is late": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিরোনাম, যেমন Normal-2 দেরিতে আসবে"
          }
        }
      }
    },
    "To %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পর্যন্ত"
          }
        }
      }
    },
    "To %@ · %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ পর্যন্ত · %2$@"
          }
        }
      }
    },
    "Too many tries. Wait a few minutes and try again.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেকবার চেষ্টা করা হয়েছে। কয়েক মিনিট অপেক্ষা করে আবার চেষ্টা করুন।"
          }
        }
      }
    },
    "Transport Admin": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবহন অ্যাডমিন"
          }
        }
      }
    },
    "Transport admin accounts are set up by the transport office.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবহন অ্যাডমিন অ্যাকাউন্ট পরিবহন দপ্তর খুলে দেয়।"
          }
        }
      }
    },
    "Transport office replied": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবহন দপ্তরের উত্তর"
          }
        }
      }
    },
    "Trip": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রিপ"
          }
        }
      }
    },
    "Trip card for %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর ট্রিপ কার্ড"
          }
        }
      }
    },
    "Trip ended": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রিপ শেষ"
          }
        }
      }
    },
    "Trip name, e.g. Normal-1": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রিপের নাম, যেমন Normal-1"
          }
        }
      }
    },
    "Trip progress": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাত্রার অগ্রগতি"
          }
        }
      }
    },
    "Tuition": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টিউশন"
          }
        }
      }
    },
    "Turned off, there is no badge and no banner on the map. You can still open News yourself, and hide single announcements by swiping them.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ থাকলে কোনো ব্যাজ বা ম্যাপে ব্যানার দেখাবে না। আপনি নিজে খবর খুলতে পারবেন, আর সোয়াইপ করে একটি একটি ঘোষণা লুকাতে পারবেন।"
          }
        }
      }
    },
    "Type": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধরন"
          }
        }
      }
    },
    "Unlock with %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ দিয়ে খুলুন"
          }
        }
      }
    },
    "Updates sent: %lld": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঠানো আপডেট: %lld"
          }
        }
      }
    },
    "Use %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ব্যবহার করুন"
          }
        }
      }
    },
    "Use your @%@ email. Your roll number must match the one in it. We'll email you a link to confirm.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার @%@ ইমেইল ব্যবহার করুন। রোল নম্বরটা ইমেইলের রোলের সাথে মিলতে হবে। নিশ্চিত করতে আমরা একটা লিংক পাঠাব।"
          }
        }
      }
    },
    "Use your KUET staff email (ending in %@).": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার KUET স্টাফ ইমেইল ব্যবহার করুন (শেষে %@)।"
          }
        }
      }
    },
    "Use your KUET staff email. We'll email you a link, and the transport office checks your employee ID.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার KUET স্টাফ ইমেইল ব্যবহার করুন। আমরা একটা লিংক পাঠাব, আর পরিবহন দপ্তর আপনার কর্মচারী আইডি যাচাই করবে।"
          }
        }
      }
    },
    "Use your KUET student email (ending in @%@).": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার KUET শিক্ষার্থী ইমেইল ব্যবহার করুন (শেষে @%@)।"
          }
        }
      }
    },
    "Verification email sent to %@.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ যাচাইয়ের ইমেইল পাঠানো হয়েছে।"
          }
        }
      }
    },
    "Verify your KUET email": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার KUET ইমেইল যাচাই করুন"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংস্করণ"
          }
        }
      }
    },
    "Waiting at %@ · Cancel": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ অপেক্ষা করছি · বাতিল"
          }
        }
      }
    },
    "Waiting for GPS...": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS-এর অপেক্ষায়..."
          }
        }
      }
    },
    "Waiting for approval": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমোদনের অপেক্ষায়"
          }
        }
      }
    },
    "We sent a link to %@. Open it, then come back and tap the button below.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ একটা লিংক পাঠিয়েছি। সেটা খুলে এখানে ফিরে নিচের বোতামে চাপুন।"
          }
        }
      }
    },
    "What happened?": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী হয়েছিল?"
          }
        }
      }
    },
    "When": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কখন"
          }
        }
      }
    },
    "Which bus? (optional)": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন বাস? (ঐচ্ছিক)"
          }
        }
      }
    },
    "Write a reply": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর লিখুন"
          }
        }
      }
    },
    "Wrong passcode": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভুল পাসকোড"
          }
        }
      }
    },
    "You are not signed in.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সাইন ইন করেননি।"
          }
        }
      }
    },
    "You are the only transport admin. Make another account an admin in the Firebase console before deleting this one.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনিই একমাত্র ট্রান্সপোর্ট অ্যাডমিন। এই অ্যাকাউন্ট মোছার আগে Firebase কনসোলে অন্য একটি অ্যাকাউন্টকে অ্যাডমিন করুন।"
          }
        }
      }
    },
    "You can save up to %lld places.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সর্বোচ্চ %lldটি জায়গা রাখতে পারবেন।"
          }
        }
      }
    },
    "Your details": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার তথ্য"
          }
        }
      }
    },
    "Your running trip will be ended first.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে আপনার চলমান ট্রিপ শেষ করা হবে।"
          }
        }
      }
    },
    "hours": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঘণ্টা"
          }
        }
      }
    },
    "min": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিনিট"
          }
        }
      }
    },
    "next in %@ km": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরেরজন %@ কিমি পরে"
          }
        }
      }
    },
    "next in %lld m": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরেরজন %lld মিটার পরে"
          }
        }
      }
    },
    "next is here": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরেরজন এখানেই"
          }
        }
      }
    },
    "to %@": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পর্যন্ত"
          }
        }
      }
    },
    "your email": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইমেইল"
          }
        }
      }
    },
    "your stop": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার স্টপ"
          }
        }
