      }
    },
    "Set your stop in the Routes tab to see the ETA.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৌঁছানোর সময় দেখতে রুট ট্যাব থেকে আপনার স্টপ ঠিক করুন।"
          }
        }
      }
    },
    "Sharing live location": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ লোকেশন শেয়ার হচ্ছে"
          }
        }
      }
    },
    "Show": {
