    },
    "%@ becomes the regular driver from today.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ থেকে %@ নিয়মিত চালক হবেন।"
          }
        }
      }
    },
    "%@ drives %@ now. The two buses will swap drivers.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ এখন %2$@ চালান। দুই বাসের চালক অদলবদল হবে।"
          }
        }
      }
    },
    "%@ is almost here": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ প্রায় চলে এসেছে"
          }
        }
      }
    },
    "%@ may not run today": {
      "localizations": {
