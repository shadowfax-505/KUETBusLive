    "Resolved": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমাধান হয়েছে"
          }
        }
      }
    },
    "Riders often get on between stops by asking the driver or waving. Pick where you usually wait.": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেকে চালককে বলে বা হাত নেড়ে দুই স্টপের মাঝে বাসে ওঠেন। আপনি সাধারণত যেখানে দাঁড়ান সেটি বেছে নিন।"
          }
        }
      }
    },
    "Role": {
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভূমিকা"
